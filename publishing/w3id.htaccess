# DRAFT redirect rules for https://w3id.org/ontoforge/weso/
# Submit under ontoforge/weso/.htaccess in perma-id/w3id.org. Replace OWNER.

Options +FollowSymLinks
RewriteEngine on

# Content negotiation for the ontology
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^$ https://raw.githubusercontent.com/OWNER/weso/main/ontology/weso-core.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://github.com/OWNER/weso/releases/latest/download/weso-full.owl [R=303,L]

# Versioned IRIs
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)/?$ https://raw.githubusercontent.com/OWNER/weso/v$1/ontology/weso-core.ttl [R=303,L]

# JSON-LD context
RewriteRule ^context\.jsonld$ https://raw.githubusercontent.com/OWNER/weso/main/ontology/weso-context.jsonld [R=303,L]

# Imports and alignment modules
RewriteRule ^imports/(.+)$ https://raw.githubusercontent.com/OWNER/weso/main/ontology/imports/$1 [R=303,L]
RewriteRule ^align/rds-wtg/?$ https://raw.githubusercontent.com/OWNER/weso/main/alignments/rds-wtg/rds-wtg.ttl [R=303,L]

# Everything else (term IRIs, browsers) to the documentation
RewriteRule ^(.*)$ https://OWNER.github.io/weso/ [R=303,L]
